def is_int(s):
    try:
        int(s)
        return True
    except ValueError:
        return False

def is_float(s):
    try:
        float(s)
        return True
    except ValueError:
        return False

def float_percent(s):
	if str(s).strip().endswith("%"):
		tmp_float = float(str(s).strip()[0:-1])
	else:
		tmp_float = float(s.strip())
	if tmp_float > 1:
		tmp_float = tmp_float / 100
	return tmp_float 

