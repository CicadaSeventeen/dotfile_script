def get_lang_code():
	locale_str = os.environ.get('LC_ALL') or os.environ.get('LANG')
	if locale_str:
		return locale_str
	return 'C'

def set_lang(lang_code):
	for key in list(dictTransStr):
		if key in lang_code.lower():
			return dictTransStr[key]
	return dictTransStr["C"]
	
dictStr = set_lang(get_lang_code())

def runCommand(command_list):
	try:
		result = subprocess.run	(command_list,
			capture_output=True,
			text=True,
			check=True
		)
		return result.stdout.strip()
	except subprocess.CalledProcessError as e:
		print(f"Error:\nReturn with {e.returncode}")
		print("Stderr:\n",e.stderr)
		print("Stdout:\n",e.stdout)
		exit(1)
	except FileNotFoundError:
		print("Error:Commnadnotfount")
		exit(1)
	except Exception as e:
		print(f"发生其他错误:{e}")
		exit(1)

def is_int(s):
    try:
        int(s)
        return True
    except ValueError:
        return False

def is_float(s):
    try:
        float(s)
        return True
    except ValueError:
        return False

def getDefaultSink():
	return runCommand(["pactl","get-default-sink"])

def getSinkVolumeString():
	return runCommand(["pactl","get-sink-volume",getDefaultSink()])

def getSinkVolumePercent():
	volume_list = []
	for tmp2 in [ tmp.split("/")[-1].strip() for tmp in getSinkVolumeString().split("%") ]:
		if (is_float(tmp2)):
			volume_list.append(float(tmp2))
	return float(sum(volume_list)/len(volume_list))

def getSinkVolumeAbs():
	volume_list = []
	for tmp2 in [ tmp.split("/")[0].strip() for tmp in getSinkVolumeString().split(":") ]:
		if (is_int(tmp2)):
			volume_list.append(int(tmp2))
	return int(sum(volume_list)/len(volume_list))

def getSinkVolumeDB():
	volume_list = []
	for tmp2 in [ tmp.split("/")[-1].strip() for tmp in getSinkVolumeString().split("dB") ]:
		if (is_float(tmp2)):
			volume_list.append(float(tmp2))
	return float(sum(volume_list)/len(volume_list))

def setSinkVolume(volume):
	runCommand(["pactl","set-sink-volume",getDefaultSink(),str(volume)])
	return None
changeSinkVolume = setSinkVolume

def setSinkMute(arg="toggle"):
	runCommand(["pactl","set-sink-mute",getDefaultSink(),arg])
	return None

def getSinkMute(arg="toggle"):
	return runCommand(["pactl","get-sink-mute",getDefaultSink()])

def main():
	args = []
	split_chars = {'a', 'd', 's', 'g', '+', '-', '=', 'm'}
	mode_str = {"add","dec","set","get","mute"}
	if (len(sys.argv) >1):
		first_str = sys.argv[1]
		if len(first_str) > 1 and first_str[0] in split_chars and (first_str not in mode_str):
			leading_char = first_str[0]
			remainder = first_str[1:]
			args = [leading_char, remainder] + sys.argv[2:]
		else:
			args = sys.argv[1:]
		if (args[0] == "set") or (args[0] == "s") or (args[0] == "="):
			mode = "set"
			args = args[1:]
		elif (args[0] == "get") or (args[0] == "g"):
			mode = "get"
			args = args[1:]
		elif (args[0] == "add") or(args[0] == "a")  or (args[0] == "+"):
			mode = "add"
			args = args[1:]
		elif (args[0] == "dec") or (args[0] == "decrease") or (args[0] == "d") or (args[0] == "-"):
			mode = "dec"
			args = args[1:]
		elif (args[0] == "mute") or (args[0] == "m"):
			mode = "mute"
			args = args[1:]
		else:
			mode = "get"
	else:
		mode = "get"
		args = []
	if (mode == "get"):
		if (len(args) > 0 and args[0].lower() == "db"):
			result = str(getSinkVolumeDB()) + "dB"
		elif (len(args) > 0 and (args[0].lower() == "abs" or args[0].lower() == "absolute" or args[0].lower() == "value")):
			result = getSinkVolumeAbs()
		else:
			result = str(int(getSinkVolumePercent())) + "%"
	elif (mode == "set"):
		if len(args) > 0:
			setSinkVolume(str(args[0]))
		result = str(int(getSinkVolumePercent())) + "%"
	elif (mode == "add"):
		if len(args) > 0:
			changeSinkVolume("+" + str(args[0]))
		else:
			changeSinkVolume("+5%")
		result = str(int(getSinkVolumePercent())) + "%"
	elif (mode == "dec"):
		if len(args) > 0:
			changeSinkVolume("-" + str(args[0]))
		else:
			changeSinkVolume("-5%")
		result = str(int(getSinkVolumePercent())) + "%"
	elif (mode == "mute"):
		if len(args) > 0 and (args[0] == "1" or args[0] == "0"):
			setSinkMute(args[0])
		else:
			setSinkMute()
		print(getSinkMute())
		runCommand(["sh","-c","command -v notify-send && notify-send -e -t 500" + " -a " + dictStr["speaker"] + " '" + dictStr["mute"] + ": " +  dictStr[getSinkMute().split()[1].strip()] + "'" ])
		result = None
	if result != None:
		print(result)
		runCommand(["sh","-c","command -v notify-send && notify-send -e -t 500" + " -a " + dictStr["speaker"] + " '" + dictStr["volume"] + ": " + result + "'" ])
		
if __name__ == "__main__":
	main()
