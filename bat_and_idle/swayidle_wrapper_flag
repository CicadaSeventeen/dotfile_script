#!/usr/bin/env python3
import os
import signal

PID_FILE = os.path.join(os.getenv("XDG_RUNTIME_DIR", "/tmp"), ".py_managed_pids")

def pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)  # 不发信号，只检查
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True  # 没权限但存在

def main():
    if not os.path.exists(PID_FILE):
        print("OFF")
        return 1

    with open(PID_FILE) as f:
        pids = []
        for line in f:
            try:
                pids.append(int(line.strip()))
            except ValueError:
                pass

    alive = [pid for pid in pids if pid_alive(pid)]

    if alive:
        print(f"ON ({len(alive)}/{len(pids)} alive)")
        return 0
    else:
        print("OFF (stale pid file)")
        return 2

if __name__ == "__main__":
    main()
